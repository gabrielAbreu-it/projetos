{
  "name": "monitoria",
  "version": "1.5.3",
  "main": "server.ts",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "build": "npx prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/server.ts\"",
    
    "test:e2e": "mocha --require tsx --require tests/e2e/setup.ts tests/e2e/login.test.ts tests/e2e/cadastro.test.ts tests/e2e/monitorias-disponiveis.test.ts tests/e2e/gerenciar-monitorias.test.ts --timeout 30000",

    "performance:smoke": "k6 run -e BASE_URL=http://localhost:3000 tests/performance/smoke/smoke-login.js",
    "performance:smoke:prod": "k6 run -e BASE_URL=https://projetointegeradormonitoria.onrender.com tests/performance/smoke/smoke-login.js",
    "performance:smoke:monitorias": "k6 run -e BASE_URL=http://localhost:3000 tests/performance/smoke/smoke-monitorias.js",
    "performance:smoke:monitorias:prod": "k6 run -e BASE_URL=https://projetointegeradormonitoria.onrender.com tests/performance/smoke/smoke-monitorias.js",
    "performance:load": "k6 run -e BASE_URL=http://localhost:3000 tests/performance/load/load-monitorias.js",
    "performance:load:prod": "k6 run -e BASE_URL=https://projetointegeradormonitoria.onrender.com tests/performance/load/load-monitorias.js",
    "performance:stress": "k6 run -e BASE_URL=http://localhost:3000 tests/performance/stress/stress-monitorias.js",
    "performance:stress:prod": "k6 run -e BASE_URL=https://projetointegeradormonitoria.onrender.com tests/performance/stress/stress-monitorias.js",
    "performance:spike": "k6 run -e BASE_URL=http://localhost:3000 tests/performance/spike/spike-login.js",
    "performance:spike:prod": "k6 run -e BASE_URL=https://projetointegeradormonitoria.onrender.com tests/performance/spike/spike-login.js",
    "performance:soak": "k6 run -e BASE_URL=http://localhost:3000 tests/performance/soak/soak-mixed.js",
    "performance:soak:prod": "k6 run -e BASE_URL=https://projetointegeradormonitoria.onrender.com tests/performance/soak/soak-mixed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.5.2",
    "@types/uuid": "^10.0.0",
    "@types/yup": "^0.29.14",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^8.5.1",
    "node-cron": "^4.2.1",
    "uuid": "^13.0.0",
    "yuo": "^0.0.1",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@types/k6": "^2.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node-cron": "^3.0.11",
    "@types/selenium-webdriver": "^4.35.6",
    "chromedriver": "^149.0.3",
    "mocha": "^11.7.6",

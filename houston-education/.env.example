# ==========================================
# AMBIENTE DE DESENVOLVIMENTO LOCAL
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA commit o arquivo .env real no repositório.
# ==========================================

# Porta onde a aplicação irá rodar localmente
PORT=3000

# Segredo usado para assinar os tokens JWT.
# Substitua por uma string aleatória e forte em produção.
JWT_SECRET=segredo_para_desenvolvimento_apenas

# Tempo de expiração dos tokens JWT
JWT_EXPIRES_IN=2h

# ==========================================
# BANCO DE DADOS (CockroachDB)
# ==========================================
# 1. Suba o CockroachDB (veja o README).
# 2. Crie o banco de dados com o nome desejado.
# 3. Substitua <NOME_DO_BANCO> pelo nome do banco criado.
#
# Exemplo com banco chamado "houstoneducationlocal":
# DATABASE_URL="postgresql://root@localhost:26257/houstoneducationlocal?schema=public&sslmode=disable&options=-c%20create_table_with_schema_locked=off"
DATABASE_URL="postgresql://root@localhost:26257/<NOME_DO_BANCO>?schema=public&sslmode=disable&options=-c%20create_table_with_schema_locked=off"

# ==========================================
# SENHA DO ADMIN (SEED)
# ==========================================
# Essas credenciais são usadas apenas para criar o usuário admin inicial.
# Os valores abaixo já estão codificados em base64 para funcionarem no seed.
# Senha em texto: AdminDev123  |  Pepper em texto: devpepper123
ADMIN_PASSWORD=QWRtaW5EZXYxMjM=
ADMIN_PASSWORD_PEPPER=ZGV2cGVwcGVyMTIz


# ==========================================
# QASE.IO - REGISTRO DE TESTES (OPCIONAL)
# ==========================================
# Preencha apenas se for integrar com o Qase para registro de testes.
# Gere o token em: https://app.qase.io/user/api/token
QASE_API_TOKEN=seu_token_aqui
QASE_PROJECT_CODE=MONITORIA

# Página inicial do Espaço Aluno (onde o login acontece).
PORTAL_URL=https://espacoaluno.uniceub.br/
# Opcional: trecho de URL que só aparece depois do login (ajuda a detectar que entrei).
PORTAL_URL_LOGADO=
# Opcional: seletor CSS que só existe depois do login.
PORTAL_SELETOR_LOGADO=
# Opcional: seletor CSS dos links das disciplinas (se a heurística não achar).
PORTAL_SELETOR_DISCIPLINAS=
# Opcional: caminho de um Chrome/Chromium já instalado (senão usa o do `playwright install chromium`).
PORTAL_NAVEGADOR=

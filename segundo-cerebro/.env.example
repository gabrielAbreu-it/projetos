# Copie para .env (que não vai para o git) e preencha.
# Projeto segundo-cerebro. Nunca usar o projeto da STRATON aqui.
SUPABASE_URL=https://nzydtjhcibzazcotyabp.supabase.co
# Supabase > Project Settings > API Keys > service_role (legacy JWT). Só nesta máquina.
